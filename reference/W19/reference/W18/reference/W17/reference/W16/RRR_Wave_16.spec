          },
          {
            "id": "W16.BIO.02",
            "statement": "A mother, current companion, recorded mating partner and verified contributing parent are different kinds of evidence.",
            "purpose": "Unknown prior mating must not be replaced by convenient invented paternity."
          },
          {
            "id": "W16.BIO.03",
            "statement": "Quantitative performance, structural morphology, developmental expression, current condition, preparation and fit remain separate causes.",
            "purpose": "A fed larva, well-aligned graft or conditioned wing cannot be credited as a newly inherited improvement."
          },
          {
            "id": "W16.BIO.04",
            "statement": "Continuous useful variation is permitted; correlated traits and categorical morphologies require their own declared relationships.",
            "purpose": "Three independent binary loci remain historical test inputs rather than every donor’s biology."
          },
          {
            "id": "W16.BIO.05",
            "statement": "A missing-contribution target can be satisfied by a parent that fails the final product specification.",
            "purpose": "Maintain meaningful founder selection and useful intermediate generations."
          },
          {
            "id": "W16.BIO.06",
            "statement": "A habitat changes what populations and evidence can plausibly be encountered; it never edits a captured genome to match the current project.",
            "purpose": "Field knowledge creates a reason to return without functioning as a trait grant."
          },
          {
            "id": "W16.BIO.07",
            "statement": "An observed exceptional individual, observed inheritance and a repeated supply claim are three different achievements.",
            "purpose": "No morphology label becomes a breeding guarantee or universal high grade."
