  "Review": {
    "amendments": [
      {
        "id": "W18.AMEND.01",
        "title": "Longwing is a differentiated four-surface flight array",
        "prior": [
          "W14.PART.LONGWING",
          "W16.PREP.LONGWING"
        ],
        "earlier": "Earlier shorthand described long paired surfaces without specifying the forewing/fan-hindwing distinction.",
        "current": "The complete reference array contains a left/right forewing pair and a left/right fan-hindwing pair with their required roots. Surface-only and complete-rooted packages are different offerings.",
        "purpose": "Removes a misleading two-wing shortcut and gives folding, root control and useful deformation explicit design jobs."
      },
      {
        "id": "W18.AMEND.02",
        "title": "Wingbeat coordination is not universal synchronization",
        "prior": [
          "W14.MAP.GAIT",
          "W14.PART.LOCKSTEP"
        ],
        "earlier": "Paired release precision can be desirable for a Hopper and was adjacent to general coordination language.",
        "current": "Hopper bilateral release, fore/hind flight phase and transmission leverage are distinct. Cyclic arrays may need a useful relative phase rather than simultaneous motion everywhere.",
        "purpose": "Prevents the best jump synchronizer from becoming an automatic best-in-slot flight gearbox."
      },
      {
        "id": "W18.AMEND.03",
        "title": "A flight-drive label does not include the entire flight system",
        "prior": [
          "W14.PART.REDLINE",
          "W14.SET.SKY"
        ],
        "earlier": "Adapting a drive for flight could be read as supplying new control, four wings and a second complete running transmission.",
        "current": "Every output path, yoke, supported root, control response and retained native function is declared once. Prepared duty and mount change; undocumented duplicate systems do not appear.",
        "purpose": "Keeps the motor/gears/body/reserve comparison faithful to its functional source."
      },
      {
        "id": "W18.AMEND.04",
        "title": "Air-relative motion refines the old stationary-aero shorthand",
        "prior": [
          "W14.ANATOMY.RACE_READINGS",
          "W14.PART.BROWFOIL"
        ],
        "earlier": "Earlier text rejected effects while stationary without always naming the reference frame.",
        "current": "Aero depends on actual relative air interaction. A stationary-on-the-ground surface in moving air can be loaded; still air plus no relevant surface motion supplies no such force.",
        "purpose": "Corrects a physically important oversimplification before adding airflow courses, without importing aircraft coefficients."
      },
      {
        "id": "W18.AMEND.05",
        "title": "Sweep and carrying envelopes are different",
        "prior": [
          "W14.ANATOMY.BODYPLAN",
          "W16.MATERIAL.WING"
        ],
        "earlier": "A narrow packed body or folded wing could be mistaken for the width the racer occupies throughout powered flight.",
        "current": "Record rest, active sweep and usable transition envelopes. Folded passage is legitimate only if the resulting mode can complete the movement with actual support and supply.",
        "purpose": "Makes fit and aerial passing concrete without an arbitrary species-size ban."
      },
      {
        "id": "W18.AMEND.06",
        "title": "Rivetback names the previously unnamed recovery donor",
        "prior": [
          "W14.PART.KICKBACK",
          "W16.PREP.KICKBACK"
        ],
        "earlier": "The reference named a click-beetle source but did not distinguish a source form, larva, adult or component lifecycle.",
        "current": "Rivetback is the working name for that source. Adults supply the complete rooted hinge; larvae and pupae have their own roles and do not contain a ready miniature module.",
        "purpose": "Closes the source monograph without inventing an additional independent recovery item."
      },
      {
        "id": "W18.AMEND.07",
        "title": "Recovery needs support and a compatible load path",
        "prior": [
          "W14.ACTION.RIGHT",
          "W16.MATERIAL.ELASTIC"
        ],
        "earlier": "A powerful recovery snap could be interpreted as universally righting, airborne rescue or a timed reset.",
        "current": "The actual support, clearance, loading anatomy and receiving contacts determine recovery. Lost time, route, material and energy are not restored.",
        "purpose": "Gives a useful optional mechanism and its counterexamples rather than a spare-life mechanic."
      },
      {
        "id": "W18.AMEND.08",
        "title": "Boiler readiness and material supply are separate",
        "prior": [
          "W14.PART.BOILER",
          "W16.MATERIAL.GLAND"
        ],
        "earlier": "Recharge language can conflate control recovery with the production of new discharge contents.",
        "current": "Mechanical readiness, fill, outlet condition and replenishment are separate. A short recovery interval cannot mint material; a loaded failed valve is not ready offense.",
        "purpose": "Creates legitimate valve, supply and preparation work without a cooldown-based infinite ammunition loop."
      },
      {
        "id": "W18.AMEND.09",
        "title": "The Caustic juvenile uses a different production resource",
        "prior": [
