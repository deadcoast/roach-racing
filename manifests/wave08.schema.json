{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RRR W08 exchange specification",
  "type": "object",
  "required": [
    "manifest",
    "Reference",
    "Plan",
    "Workflow",
    "Adherence",
    "rules",
    "profiles",
    "entities",
    "world_threads",
    "experiments",
    "MIVIM",
    "limitations",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "object"
    },
    "Reference": {
      "type": "object"
    },
    "Plan": {
      "type": "object"
    },
    "Workflow": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "Adherence": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "origin",
          "refines",
          "statement",
          "decision",
          "observable",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "refines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "observable": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profiles": {
      "type": "object"
    },
    "entities": {
      "type": "array"
    },
    "world_threads": {
      "type": "array"
    },
    "experiments": {
      "type": "object"
    },
    "MIVIM": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    }
  }
}
