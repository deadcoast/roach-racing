      {
        "id": "W15.SYSTEM.RACING",
        "title": "Useful mechanical opportunities instead of hidden equipment locks",
        "prior_refs": [
          "W14.ACTION.RUN",
          "W14.ACTION.HOP",
          "W14.ACTION.GRASP",
          "W11.FORMAT.01",
          "W09.BRAKE.09"
        ],
        "source_ids": [
          "W15.S01",
          "W15.S03",
          "W15.S11",
          "W15.S13"
        ],
        "problem": "Correct equations or anatomical descriptions are insufficient if the advertised action rarely works, cannot be read, or only solves a single mandatory obstacle.",
        "design_intent": "Give each prominent construction recurring, understandable opportunities to race well, including genuine speed gains and conditional tactical choices.",
        "rules": [
          {
            "id": "W15.RACING.01",
            "statement": "A promoted component has a named opportunity envelope: relevant load, contact, supply, geometry, approach and available response. A course does not secretly activate its benefit by item ID.",
            "purpose": "The same mechanism matters wherever its actual conditions occur."
          },
          {
            "id": "W15.RACING.02",
            "statement": "Every published course challenge provides at least two physically plausible response families unless it is explicitly a specialist demonstration. The alternatives need not be equally fast or use identical budgets.",
            "purpose": "A short landing can invite braking, changed approach/gearing or a different approved route rather than one obligatory rare part."
          },
          {
            "id": "W15.RACING.03",
            "statement": "For a signature action, the reference defines an enabling case, a non-enabling case and a case where altered anatomy or fitting materially changes the outcome.",
            "purpose": "A Hopper, Catchclaw or rail guide cannot be called successful design because its code branch exists."
          },
          {
            "id": "W15.RACING.04",
            "statement": "A useful hop includes a loading opportunity, actual separation or route advantage, a reachable landing and recovered running. Available power and closing motion remain prerequisites, but the encounter repertoire must contain real opportunities to satisfy them.",
            "purpose": "Do not hide timing failures behind a jump-win bonus or accept a flagship action that never occurs."
          },
          {
            "id": "W15.RACING.05",
            "statement": "A grasping build describes reach, closing time, support and release. A held rival can cost both racers time; choosing when not to grasp is a legitimate race tendency.",
            "purpose": "The original mantis response remains a contextual racing tactic, not an unconditional stun."
          },
          {
            "id": "W15.RACING.06",
            "statement": "Display mass, drive, supply, geometry and action as related inputs. Preserve a genuinely faster or more efficient part when it is genuinely better; no compulsory compensating weakness is added to every discovery.",
            "purpose": "Progress includes superiority as well as specialization."
          },
          {
            "id": "W15.RACING.07",
            "statement": "A post-race explanation cites visible events and measured inputs under stated conditions. A component-only change and a whole-build change are different comparisons.",
            "purpose": "A close victory remains a victory before it becomes an engineering report."
          },
          {
            "id": "W15.RACING.08",
            "statement": "Courses are authored as racing spaces: clean running, traffic, surface transitions and maneuver windows coexist. Do not add an obstacle merely to sell its exclusive counter.",
            "purpose": "Challenge should reward construction and decisions rather than enforce a shopping checklist."
          }
        ],
        "worked_definition": {
          "input": "A Last Laugh build on a mixed club course with a short shared straight and a longer unobstructed landing run.",
          "decision": "Choose a lower controllable hop for nearby traffic or remain running when no useful clearance exists.",
          "completion": "The observer can identify loading, a real positional change or failed attempt, landing and resumed pace.",
          "next_routes": "Improve synchronization, remount, change preload, adjust the drive/contact combination, or choose a different route.",
          "failure": "A late launch may fail, but the developer must also supply representative encounters where correct timing and the same anatomy can succeed."
        },
        "object_ids": [
          "W15.OBJECT.COURSE_BRIEF",
          "W15.OBJECT.COMPARISON_SLIP"
        ],
        "limits": [
          "No new race solver, winner or numerical lap comparison is produced in this milestone.",
          "Multi-roach contact, aerial motion and control fidelity still require implementation and human observation."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.FIELD",
        "title": "One source ecology, several depths of collecting",
        "prior_refs": [
          "W14.BREED.SOURCE",
          "W13.OBSERVE.05",
          "W03.INTAKE.03"
        ],
        "source_ids": [
          "W15.S05",
          "W15.S07",
          "W15.S08"
        ],
        "problem": "Opaque genes, paid assays and several failure filters can make rare hunting a sequence of blind expenses; quick and spatial routes can also become unrelated worlds.",
        "design_intent": "Make field expertise improve the decision to acquire a particular insect without manufacturing certainty or compulsory exploration.",
        "rules": [
          {
            "id": "W15.FIELD.01",
            "statement": "Every collecting method names its actual source population and cohort. Quick and detailed visits use that relationship, or explicitly different nearby populations; one site cannot supply duplicate copies through two interfaces.",
            "purpose": "The amount of interaction changes; the world identity does not."
          },
          {
            "id": "W15.FIELD.02",
            "statement": "Baseline observation reveals visible form, useful life stage, actual damage, accessible anatomy and contextual behavior. A short screen can disclose a bounded response under its conditions.",
            "purpose": "The player has something useful to notice before buying precision."
          },
          {
            "id": "W15.FIELD.03",
            "statement": "Workshop measurements add controlled values; descendant evidence adds information about observed offspring. Neither an appearance nor a field movement claims exact hidden alleles.",
            "purpose": "Preserve discovery and honest uncertainty rather than making the catalogue omniscient."
          },
          {
            "id": "W15.FIELD.04",
            "statement": "The field choice specifies desired anatomy, compatible containment, home capacity and at least one possible ordinary use. A general outing remains allowed and can return without profit.",
            "purpose": "A rare target sits above useful ordinary possibilities rather than being the only nonzero outcome."
          },
          {
            "id": "W15.FIELD.05",
            "statement": "Probability review follows the whole route: encounter, visibility, approach, capture, preserved anatomy, useful stage, reproductive eligibility and eventual target. Do not independently lower every success rate until the product becomes unattainable.",
            "purpose": "Challenge comes from selected decisions and scarce combinations, not unnoticed multiplication of punitive filters."
          },
          {
            "id": "W15.FIELD.06",
            "statement": "A competent method reduces its relevant uncertainty or damage; it does not improve the genome after capture. Individual outcomes stay fixed once the corresponding world event occurs.",
            "purpose": "Knowledge can make a search better without a generic luck stat."
          },
          {
            "id": "W15.FIELD.07",
            "statement": "Buying a measured part, an observed founder or a declared reproductive unit is the reliable acquisition alternative for a player who does not enjoy repeated searches. Neither route grants an intrinsic quality premium.",
            "purpose": "Rare exploration remains an option, not an obligation for every competitive build."
          },
          {
            "id": "W15.FIELD.08",
            "statement": "A return report separates cash changes from secured stock, preserved anatomy, observations and continuing home costs. One useful ordinary animal is not automatically cash, and one informative glimpse is not ownership.",
            "purpose": "The player can judge what the outing actually achieved."
          },
          {
            "id": "W15.FIELD.09",
            "statement": "Useful-stage catches receive an intelligible next-action window and an accessible supported holding/preparation option in the relevant settlement. Its exact limits belong to the donor profile.",
            "purpose": "A special stage creates a choice instead of an unavoidable surprise expiration after returning."
          }
        ],
        "worked_definition": {
          "input": "A high-purchase Glassfoot line lacks quick release; the Glazed Overgrowth source is known.",
          "decision": "Inspect unloading and peel behavior, preserve pads, and keep a promising moderate-grip animal as a candidate founder.",
          "completion": "The same animal returns; a field note says what was seen and does not certify the entire genotype.",
          "next_routes": "Controlled assay, direct pad preparation, breeding, trade or collection.",
          "failure": "A damaged pad may lose direct-use value while the animal’s reproductive eligibility is evaluated separately."
        },
        "object_ids": [
          "W15.OBJECT.FIELD_BRIEF",
          "W15.OBJECT.DISPOSITION_CARD"
        ],
        "limits": [
          "Population biology and exact encounter distributions are donor-monograph work.",
          "Quick mode need not guarantee equal catch counts or equal information; it must disclose differences in method, time, cost and preservation."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.BROOD",
        "title": "Split-brood projects: research, current use and sale in one line",
        "prior_refs": [
          "W03.INTAKE.02",
          "W06.BREED.07",
          "W08.LINE.05",
          "W12.BREEDER.09",
          "W14.BREED.PROJECTS"
        ],
        "source_ids": [
          "W15.S08",
          "W15.S09"
        ],
        "problem": "An ambitious breeding target can turn most offspring into apparent failures and turn every batch into more protected mouths to feed.",
        "design_intent": "Give a line intermediate achievements and an explicit, bounded disposition plan without trivializing inheritance or automatically choosing all valuable animals.",
        "rules": [
          {
            "id": "W15.BROOD.01",
            "statement": "A project records the desired eventual construction, current missing contribution and available evidence separately. A candidate parent is judged by the contribution it can plausibly add, not required to be the final product.",
            "purpose": "Preserve the weak-jumper/good-synchronization opportunity."
          },
          {
            "id": "W15.BROOD.02",
            "statement": "Recognize four distinct milestones: a plausible founder contribution, observed expression in descendants, a useful combined individual, and repeat observed output meeting a named specification. None implies the next has already happened.",
            "purpose": "Progress becomes visible before an entire line is perfected."
          },
          {
            "id": "W15.BROOD.03",
            "statement": "The brood plan allocates possible mature output among research review, personal components, funded ordinary supply and replacement candidates. Those are goals for real outcomes, not guarantees of counts or sexes.",
            "purpose": "A mixed generation can serve several purposes without cloning bodies."
          },
          {
            "id": "W15.BROOD.04",
            "statement": "A replacement policy targets a maintained reserve by role and condition rather than adding two permanent keepers from every brood. If the reserve is already filled, additional candidates request a deliberate substitution, display, sale or retention choice.",
            "purpose": "Reliable production does not automatically become an ever-growing stock liability."
          },
          {
            "id": "W15.BROOD.05",
            "statement": "Research holds take priority over automated ordinary dispatch only through explicit project criteria and consent. Unknown potentially interesting stock may go to Review; the player can choose an ordinary unscreened sales policy.",
            "purpose": "Automation remains useful without pretending it knows which hidden genomes are worthless."
          },
          {
            "id": "W15.BROOD.06",
            "statement": "Useful nonpremium output has a current purpose named before the final rare target is balanced: ordinary Hoppers, joint-only material, complementary breeders or a customer’s narrower requirement.",
            "purpose": "A failed ultimate combination need not be a failed whole project."
          },
          {
            "id": "W15.BROOD.07",
            "statement": "Paired reproductive roles, fertility, survival, inherited combinations and product acceptance remain separate. The player may buy a known compatible unit or seek another founder; repeated failure does not conjure a perfect pair.",
            "purpose": "A reliable acquisition option supports continued agency while biological risk stays meaningful."
          },
          {
            "id": "W15.BROOD.08",
            "statement": "A production claim uses the customer’s actual question and records relevant tested offspring and distinct broods. The measured sample is not automatically an unbiased rate for all future offspring.",
            "purpose": "A line name can develop trust without becoming a stat or price aura."
          },
          {
            "id": "W15.BROOD.09",
            "statement": "Changing a project creates a new target branch with preserved old observations. Existing siblings can become useful under that new purpose without acquiring new genes.",
            "purpose": "New ambitions reopen the value of familiar stock and records."
          }
        ],
        "worked_definition": {
          "input": "A high-return/ordinary-synchrony Hopper founder and an ordinary-return/high-synchrony founder.",
          "decision": "Retain the useful complement and set an ordinary component outlet beside the premium combination goal.",
          "completion": "A brood produces actual individuals. Some may meet ordinary assembly requirements; others justify further selection; replacements fill only the chosen reserve.",
          "next_routes": "Fit a personal assembly, supply an ordinary kit maker, continue a selected branch, or close the project.",
          "failure": "An all-one-role brood or failed attempt remains real. A pre-existing racer and purchased supplies let other play continue rather than requiring the brood to succeed first."
        },
        "object_ids": [
          "W15.OBJECT.BROOD_CARD",
          "W15.OBJECT.DISPOSITION_CARD"
        ],
        "limits": [
          "No genetic probabilities are newly assigned here; species-specific inheritance replaces neither research nor later balancing.",
          "The plan creates useful decisions, not guaranteed profitable or target-matching offspring."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.CARE",
        "title": "Facilities as controlled commitments rather than perpetual chores",
        "prior_refs": [
          "W03.CAPACITY.03",
          "W06.BREED.07",
          "W14.GRAFT.CARE",
          "W14.BREED.NURSERY"
        ],
        "source_ids": [
          "W15.S05",
          "W15.S09"
        ],
        "problem": "More facilities or animals can increase recurring obligations faster than the available strategic choices, undermining both casual ownership and productive specialization.",
        "design_intent": "Let players choose research, production or maintenance activity using the same biology and owned facilities, with visible bounded commitments.",
        "rules": [
          {
            "id": "W15.CARE.01",
            "statement": "Research, production and maintenance are operating plans, not exclusive buildings or professions. The same suitable nursery can change plans between actual commitments.",
            "purpose": "Depth comes from use and allocation, not another forced upgrade tier."
          },
          {
            "id": "W15.CARE.02",
            "statement": "Research prioritizes observation and selected candidates; production prioritizes a named accepted-output specification and bounded replacements; maintenance stops new reproductive starts and supports existing stock.",
            "purpose": "Stopping expansion becomes an intelligible option before a cash crisis."
          },
          {
            "id": "W15.CARE.03",
            "statement": "Committed living stages and future holding are reserved through actual supported capacity. An expected low survivor count does not provide physical room for a larger viable cohort.",
            "purpose": "Simplified presentation must preserve real obligations."
          },
          {
            "id": "W15.CARE.04",
            "statement": "The breeder can split or schedule production only where the form’s reproductive and handling profile permits it. Any unselected eggs or young still receive a stated disposition; they do not vanish to fit a forecast.",
            "purpose": "Scheduling is an operational choice, not a disguised biological deletion."
          },
          {
            "id": "W15.CARE.05",
            "statement": "A breeder or racer may pay a suitable service for grow-out, supported holding, preservation or temporary boarding. Ownership, delivered stock, fees, responsibility and return conditions are stated.",
            "purpose": "Different player interests can access expertise without running every facility themselves."
          },
          {
            "id": "W15.CARE.06",
            "statement": "A readiness card states the first real blocker, committed care and the next supported transition. It does not show an unobserved exact survivor count disguised as a precise future bill.",
            "purpose": "Planning remains useful without leaking the engine’s future knowledge."
          },
          {
            "id": "W15.CARE.07",
            "statement": "Routine care executes through selected supplies and services without repeated identical manual inputs. A new problem calls for intervention only when it changes an actual outcome.",
            "purpose": "Large operations create choices about capacity, stock and customers rather than proportional feeding clicks."
          },
          {
            "id": "W15.CARE.08",
            "statement": "Offline world time pauses by default. During in-world absence, agreed services and care progress with the same calendar; no life is frozen selectively to evade a contract.",
            "purpose": "Stopping the application is safe, but ignoring an in-world living obligation is still a decision."
          },
          {
            "id": "W15.CARE.09",
            "statement": "Arrears recovery, aging and lasting injury require separate authored material profiles. This milestone permits no hidden disappearance, universal immortality, automatic regeneration or punitive loss added to solve a balance issue.",
            "purpose": "Consequences remain grounded in the intended world rather than emergency design patches."
          }
        ],
        "worked_definition": {
          "input": "A successful ordinary-stock line has filled its replacement reserve and lacks funded orders for the next batch.",
          "decision": "Switch to maintenance or select a smaller supported commitment; optionally book outside capacity for a genuinely useful order.",
          "completion": "Existing stock remains cared for; no new batch starts without consent and capacity.",
          "next_routes": "Race a prepared host, seek a new customer, improve the line or display selected stock.",
          "failure": "Unsold animals cost resources. The plan reveals that obligation before extra production rather than disguising it as passive revenue."
        },
        "object_ids": [
          "W15.OBJECT.CARE_PLAN",
          "W15.OBJECT.RETURN_CARD"
        ],
        "limits": [
          "This is a service and reference design, not an executed scheduler.",
          "Exact care prices, mortality and dormant-storage behavior are unresolved until the relevant biology chapter is authored."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.GRADES",
        "title": "Progression in useful differences, not five decorative labels",
        "prior_refs": [
          "W08.QUALIFY.07",
          "W14.MAP.SETS",
          "W14.SET.LANGUAGE",
          "W12.RECIPE.08"
        ],
        "source_ids": [
          "W15.S01",
          "W15.S03",
          "W15.S09",
          "W15.S12"
        ],
        "problem": "A conjunction-based grade can hide meaningful single-axis improvement, while a small allele alphabet may never populate the advertised intermediate bands.",
        "design_intent": "Keep meaningful qualification but make actual improvements, operating variants and recognizable new mechanisms independent progression rewards.",
        "rules": [
          {
            "id": "W15.GRADES.01",
            "statement": "Every product presents four separate questions: what function it supplies, how its observed properties compare, which declared operating profile it meets, and what appearance or history makes it desirable.",
            "purpose": "Neither rare color nor a high headline band answers every question."
          },
          {
            "id": "W15.GRADES.02",
            "statement": "Within-profile improvement is visible even when the qualification band stays unchanged. Show the actual improved axis and the criterion still limiting the next band.",
            "purpose": "A better offspring can feel and be useful before crossing a catalogue threshold."
          },
          {
            "id": "W15.GRADES.03",
            "statement": "Hobby, Club, Circuit, Premier and Apex remain names for demonstrated protocols where those steps are meaningful. A donor profile is not required to occupy every label until its supported variation and acquisition routes make them useful.",
            "purpose": "Do not fabricate reachable progression by relabeling identical anatomy."
          },
          {
            "id": "W15.GRADES.04",
            "statement": "New morphological or preparation variants require changed physical geometry, contact, movement or recognizable collection purpose. Their inheritance, prevalence and preparation belong to the source profile.",
            "purpose": "A forked horn or channelled pad must be more than a recolored percentage buff."
          },
          {
            "id": "W15.GRADES.05",
            "statement": "Geometry and operating choices remain ranges, not globally higher-better scores. Mechanical advantage, reach and braking friction may require different target bands for different projects.",
            "purpose": "Maintain useful tuning decisions while allowing actual quality improvement within the chosen operating range."
          },
          {
            "id": "W15.GRADES.06",
            "statement": "A superior part can improve several useful properties at equal burden. Keep that discovery unless a real mechanical interaction explains a limit; do not impose an unrelated weakness as a tax for progress.",
            "purpose": "The player can legitimately seek the faster roach."
          },
          {
            "id": "W15.GRADES.07",
            "statement": "Review component families against native baselines, affordable alternatives, representative courses and full-build mass/supply. An item-only improvement that is always useless after installation needs redesign or honest specialist positioning.",
            "purpose": "The part has to matter where players use it."
          },
          {
            "id": "W15.GRADES.08",
            "statement": "Performance qualification does not alter genetics, event legality or buyer payments by itself. Buyers can choose a measured profile as an acceptance shorthand but retain a real purpose and price.",
            "purpose": "The label informs a transaction; it is not a universal rarity economy."
          }
        ],
        "worked_definition": {
          "input": "A Glassfoot descendant improves peel release while remaining in the current contact qualification band because dusty purchase is still below the next threshold.",
          "decision": "Use the faster release now, retain it as a parent, or sell it for an order concerned with clean track performance.",
          "completion": "Its measured difference remains visible and can feed the same installed contact model.",
          "next_routes": "Pursue dusty purchase, a different profile or a visual variant rather than repeating an identical generic upgrade.",
          "failure": "A changed grade name without different anatomy or useful measurement is rejected as progression polish."
        },
        "object_ids": [
          "W15.OBJECT.COMPONENT_CARD",
          "W15.OBJECT.CONVERSION_GUIDE"
        ],
        "limits": [
          "No new trait range, mutation rate or band frequency is treated as calibrated.",
          "Comparative use and player recognition must be tested; complete product monographs remain the source of inheritance detail."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.LIVELIHOOD",
        "title": "Three distinct maker businesses, not one subsidized crafting funnel",
        "prior_refs": [
          "W12.DEMAND.10",
          "W12.REPAIR.07",
          "W14.INSTITUTION.FITTER",
          "W14.INSTITUTION.CINDER"
        ],
        "source_ids": [
          "W15.S04",
          "W15.S09",
          "W15.S10"
        ],
        "problem": "The documented first maker project succeeded in delivery and lost cash; calling its sale passive income would conceal a real incentive problem.",
        "design_intent": "Design distinct service, manufactured-kit and breeder-supply businesses around their actual value and costs, with an accessible earning route that does not require breeding.",
        "rules": [
          {
            "id": "W15.LIVELIHOOD.01",
            "statement": "Customer-stock fitting is a first-class commission. The client supplies and retains ownership of a named host and components; the fitter is paid for agreed preparation, arrangement and evidence.",
            "purpose": "A player can earn through building expertise without purchasing and financing an entire second racer."
          },
          {
            "id": "W15.LIVELIHOOD.02",
            "statement": "A manufactured-kit order purchases actual material stock, the living foundation, preparation, coordination and guide. A template match alone is not delivered work.",
            "purpose": "Repeatable production has a product people can assemble, not an abstract crafting completion."
          },
          {
            "id": "W15.LIVELIHOOD.03",
            "statement": "A breeder-supply order purchases live eligible animals and the stated evidence. It is priced and accepted separately from their potential extracted parts.",
            "purpose": "Fertility, compatible roles and reliable output can have economic value independent of peak race performance."
          },
          {
            "id": "W15.LIVELIHOOD.04",
            "statement": "Quote three separate quantities: incremental cost of the next delivery, allocated ongoing business overhead, and still-unrecovered research/capital spending. Purchased inputs, own-stock opportunity value and consumed supplies are labeled distinctly.",
            "purpose": "A profitable next batch and a profitable lifetime project are not the same claim."
          },
          {
            "id": "W15.LIVELIHOOD.05",
            "statement": "A fixed contract price is agreed before irreversible production. A forecast shows what assumptions make it affordable; the customer does not magically reimburse bad breeding outcomes or choose a hidden perfect sale value.",
            "purpose": "Risk remains meaningful and understandable."
          },
          {
            "id": "W15.LIVELIHOOD.06",
            "statement": "Where current terms cannot pay a competent repeat supplier for its necessary costs, redesign the quantity, input sourcing, service scope or buyer budget. Do not hide the loss as experience or relabel consumed working stock as permanent capital.",
            "purpose": "At least one deliberate ordinary livelihood must actually support upkeep under reasonable play."
          },
          {
            "id": "W15.LIVELIHOOD.07",
            "statement": "Kit-maker source requirements match the intended use. A starter commission does not demand exhaustive ancestry certification; a premium breeder claim may require multiple observed broods.",
            "purpose": "Evidence cost belongs where it buys relevant confidence."
          },
          {
            "id": "W15.LIVELIHOOD.08",
            "statement": "Retail and wholesale prices reflect different real duties: selection, care, presentation, warranty or fitting work, and customer demand. Same-counter posted-order spread checks may support transaction safety but do not define every world price.",
            "purpose": "Fix the economic cause instead of increasing all prices whenever a player finds an opportunity."
          },
          {
            "id": "W15.LIVELIHOOD.09",
            "statement": "Legitimate resale from place, timing, information, preparation or service can earn money. Repeating the same transfer without new value, a changed real buyer need or new funding cannot generate an endless self-financed return.",
            "purpose": "Commerce stays interesting without ledger exploits or blanket anti-trading restrictions."
          },
          {
            "id": "W15.LIVELIHOOD.10",
            "statement": "Compare buyer-only, catcher, breeder and fitter routes with matched starting resources, available time and product objective. Include failed attempts, care of leftovers, resale opportunities and retained assets separately.",
            "purpose": "Different route schedules are not evidence that one profession is superior."
          }
        ],
        "worked_definition": {
          "input": "An independent fitter receives a client-owned Lowline and two measured compatible drive/contact options.",
          "decision": "Agree which construction or matched measurement is wanted, inspect actual supplied condition and quote the work.",
          "completion": "The fitted host and actual observation return to the customer; a service receipt pays labor and consumed supplies.",
          "next_routes": "Accept another job, use earnings for personal parts, or develop a complete commercial kit with separately sourced inventory.",
          "failure": "If the supplied component cannot meet the requested outcome, decline or renegotiate before destructive work; no fabricated improvement is awarded."
        },
        "object_ids": [
          "W15.OBJECT.CUSTOMER_STOCK_BRIEF",
          "W15.OBJECT.QUOTE_SHEET"
        ],
        "limits": [
          "No new price list, profit rate or customer budget is claimed as balanced.",
          "W12’s -38-credit result remains unchanged evidence. A revised definition is not a retroactive refund."
        ],
        "status": "authored_working_revision_not_runtime"
      },
      {
        "id": "W15.SYSTEM.SURPLUS",
        "title": "Ordinary stock and alternate anatomy have named uses",
        "prior_refs": [
          "W02.VALUE.01",
