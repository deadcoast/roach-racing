    "systems": [
      {
        "id": "W18.SYSTEM.FLIGHT",
        "title": "A Flyer is a complete working construction",
        "problem": "A wing could otherwise become a flight-permission item whose advertised agility, lift and endurance come from hidden bonuses.",
        "definition": "The actual host, available work, wing-root delivery, deforming surfaces, support, supply and control jointly determine sustained flight. Native ground functions remain present unless explicitly replaced. The complete entry kit solves an ordinary working arrangement without asking a novice to invent a flight-control system.",
        "rules": [
          {
            "id": "W18.FLIGHT.01",
            "text": "A powered-flight array receives energy and control through declared interfaces. There is no flight stat that overrides an unpowered, obstructed or unsupported array."
          },
          {
            "id": "W18.FLIGHT.02",
            "text": "A Longwing reference array contains forewings and fan hindwings with distinct roles; a Quadwing contains four individually situated working wings. Neither name is shorthand for four independent copies of the same force."
          },
          {
            "id": "W18.FLIGHT.03",
            "text": "Loaded shape, sweep and interaction matter. Increasing span, stiffness, beat cadence or phase alignment is not unconditionally beneficial; genuine multi-property improvements remain allowed."
          },
          {
            "id": "W18.FLIGHT.04",
            "text": "Native contact and articulation remain usable for launch, perching and touchdown. They need not be replaced simply to populate a complete equipment menu."
          },
          {
            "id": "W18.FLIGHT.05",
            "text": "Sensing can support earlier correction only if the construction has a movable, powered or suitably passive response. A brace against air cannot substitute for a wing-control action."
          },
          {
            "id": "W18.FLIGHT.06",
            "text": "The kit guide identifies supplied and retained-native functions, starting reserve and ordinary first-use support. Complete means no hidden necessary organ purchase before the advertised introductory course."
          },
          {
            "id": "W18.FLIGHT.07",
            "text": "A bench observation, complete-array trial and actual race answer different questions. The reference may promise a supported operating range, not victory against every competitor."
          }
        ],
        "example": "A buyer opens a Skyhook Courtyard tin containing a conditioned Quadwing, selected flight drive, yoke, appropriate root support and reserve. They fit the actual assemblies, set the guide’s ordinary trim, name the same host and enter a broad portal loop. Owning a pond, a sensory laboratory or a champion pedigree is not required.",
        "limits": "Exact aerodynamic scales and flight parameters remain a later calibration task. This is a reference construction, not an implemented flight simulator.",
        "prior": [
          "W14.ANATOMY.JOINS",
          "W14.PART.QUADWING",
          "W16.DONOR.GLASSWING",
          "W15.ENTRY.01"
        ],
        "sources": [
          "W18.S02",
          "W18.S03",
          "W18.S06",
          "W18.S07"
        ]
      },
      {
        "id": "W18.SYSTEM.DELIVERY",
        "title": "Drive, yoke and control each have a job",
        "problem": "A familiar “gear” label could conflate muscle cadence, wingbeat, stroke leverage, timing and the host’s ability to command an adjustment.",
        "definition": "A flight drive supplies work. A yoke routes it through a specified range of motion. Coordination sets relationships between working surfaces; control changes a permitted relationship at the permitted time using actual anatomy. A complex assembly can contain several roles without being counted several times.",
        "rules": [
          {
            "id": "W18.DELIVERY.01",
            "text": "The flight-drive preparation identifies its output junction and duty. An efficient donor supplies a useful possibility; insufficient reserve delivery still limits the installed system."
          },
          {
            "id": "W18.DELIVERY.02",
            "text": "Yoke leverage states input and output motion, working force and travel. It is an operating range, not a higher-number-is-better gene."
          },
          {
            "id": "W18.DELIVERY.03",
            "text": "Crossphase coordination changes fore/hind timing where the array permits it. More synchronization is not a universal aerodynamic upgrade: a useful phase depends on duty and the complete array."
          },
          {
            "id": "W18.DELIVERY.04",
            "text": "A manually adjusted yoke remains at its fitted setting during the race unless an actual adjustable mechanism and controller are included. A slider in the guide does not create free active transmission."
          },
          {
            "id": "W18.DELIVERY.05",
            "text": "Ground and aerial work can share supply. Separate drive bundles, a routed branch or retained native ground muscle must be declared; no second fully tuned drivetrain appears from a single unqualified input."
          },
          {
            "id": "W18.DELIVERY.06",
            "text": "A root bridge transmits load and preserves permitted motion. Bracing every hinge rigidly can defeat control even while increasing static stiffness."
          },
          {
            "id": "W18.DELIVERY.07",
            "text": "Control information does not copy the donor’s whole behavior or sensory brain. The integrated host remains the actor; acquired wings do not know a new course by species name."
          }
        ],
        "example": "A Longwing with adequate muscle work but a poorly matched yoke is not cured by adding another reservoir. A fitter first checks whether the desired stroke is reached without binding, then compares the revised setting under the same supply and load.",
        "limits": "These are functional interfaces. They do not mandate a detailed gene solver, an input on every wingbeat, or a specific electronics-like controller architecture.",
        "prior": [
          "W14.MAP.GAIT",
          "W17.ASSEMBLY.04",
          "W15.BENCH.05"
        ],
        "sources": [
          "W18.S02",
          "W18.S07"
        ]
      },
      {
        "id": "W18.SYSTEM.AIR",
        "title": "Energy, airflow and useful flight modes",
        "problem": "Course speed could be confused with air-relative work; a tailwind, glide or hovering pose could become free propulsion.",
        "definition": "The public reference distinguishes how quickly a racer progresses past course landmarks from how its surfaces move relative to the air. Wind is an external condition with direction, not a regional buff. Climbing, maneuvering and sustained support use the actual construction and supplies.",
        "rules": [
          {
            "id": "W18.AIR.01",
            "text": "Airspeed and course-relative speed are separate. A fast downwind pass cannot alone certify high inherited drive or wing efficiency."
          },
          {
            "id": "W18.AIR.02",
            "text": "Hover, controlled slow flight, cruise, climb and glide are capabilities of a tested complete construction, not automatic rights granted by a wing family."
          },
          {
            "id": "W18.AIR.03",
            "text": "Gliding can trade existing motion or height against travel; it does not replenish fuel or provide indefinite support. Work needed to gain the prior height remains accounted for."
          },
          {
            "id": "W18.AIR.04",
            "text": "Slowing in the air requires appropriate force or resistance. A ventral pad that touches nothing cannot cause aerial braking, and lower drag is not the only possible useful response."
          },
          {
            "id": "W18.AIR.05",
            "text": "An announced airflow source or natural condition has location, direction, variability and an event operating allowance. It never quietly favors a named lineage or changes after reading hidden player genes."
          },
          {
            "id": "W18.AIR.06",
            "text": "A material wind change can trigger the published reinspection, pause or cancellation rule for everyone affected. Disclosure and comparable opportunity are required; exact turbulence reconstruction is not imposed on the book."
          },
          {
            "id": "W18.AIR.07",
            "text": "Supply forecasts distinguish usable contents, maximum delivery and planned duty. A temporary drop in demand is not an additional energy source, and a gauge cannot promise an unobserved future race outcome."
          }
        ],
        "example": "On the Reed Sweep course, a Longwing can carry pace around a broad outer arc while a more maneuverable Quadwing chooses a shorter but more demanding turn. In a following airflow the first may look faster relative to the ground without proving a superior motor; both still need the required next gate.",
        "limits": "No aircraft coefficient or weather simulation is transplanted into the insect scale. The statement fixes meaning before numerical modeling.",
        "prior": [
          "W14.ANATOMY.RACE_READINGS",
          "W15.RACING.07"
        ],
        "sources": [
          "W18.S16"
        ]
      },
      {
        "id": "W18.SYSTEM.SPORT",
        "title": "Flyers with Flyers, without making flight an equipment loophole",
        "problem": "Wings can be used as decoration, passive aero, active hopping aids or sustained flight. Names alone cannot determine a fair locomotion division.",
        "definition": "Classify what the ready installed construction can actually do. Aerial competition is parallel to ground competition; Open, Speedsters and Fireworks describe equipment policy within an appropriate locomotion field, not a sequence of superior species.",
        "rules": [
          {
            "id": "W18.SPORT.01",
            "text": "Repeated powered aerodynamic support or propulsion independent of ground contact places an enabled construction in the Flyer division. A roach cannot enter ground racing by promising to flap only once."
          },
          {
            "id": "W18.SPORT.02",
            "text": "A ground-division hop expends its supported launch and returns to a legal contact. Passive gliding is permitted only under the announced ground route/airborne-travel policy; it cannot erase required course progress."
          },
          {
            "id": "W18.SPORT.03",
            "text": "Flight organs physically disconnected or fixed as passive material can be evaluated by that actual state. A peaceful race-plan label or folded-looking animation is not deactivation."
          },
          {
            "id": "W18.SPORT.04",
            "text": "Flyer Speedsters exclude dedicated operative weapons, not every unusual-looking limb. Flyer Fireworks require working offense and light protection. Flyer Open has no universal part-point ceiling."
          },
          {
            "id": "W18.SPORT.05",
            "text": "Launch format, recontact rules, missed-gate treatment, between-round changes and finish conditions are public before the entry commitment. A complete Flyer does not automatically require a vertical launch or hover."
          },
          {
            "id": "W18.SPORT.06",
            "text": "Ground titles do not by themselves certify an aerial racer or skip its qualifying results. The Locals–Regionals–Factionals–New World City framework can be applied to each recognized division without merging their results."
          },
          {
            "id": "W18.SPORT.07",
            "text": "Accessible local Flyer practice and kit entry do not require an earlier ground championship or ownership of all source nurseries. Later qualification controls the relevant competition only."
          }
        ],
        "example": "A Last Laugh roach that clears one competitor through a ballistic jump can remain in a suitable ground event. Adding a powered Longwing array changes its locomotion capability. Neither the same host identity nor the maker’s product label changes that distinction.",
        "limits": "Exact capability-test distances and times need later sporting calibration. The current qualitative boundary is not permission for officials to invent an undisclosed arbitrary threshold.",
        "prior": [
          "W14.SPORT.BOUNDARIES",
          "W15.SPORT.05",
          "W14.SPORT.LADDER"
        ],
        "sources": [
          "W18.S05"
        ]
      },
      {
        "id": "W18.SYSTEM.RECOVERY",
        "title": "Recover the body without erasing the race",
        "problem": "Kickback can be trivialized as an instant reset or exaggerated as guaranteed self-righting from any posture.",
        "definition": "A recovery is a physical sequence that uses actual support and clearance. Returning to a running stance does not return the lost distance, refill supplies, undo injury or move the racer to an earlier favorable position.",
        "rules": [
          {
            "id": "W18.RECOVERY.01",
            "text": "Native-leg righting remains a valid option when the host can do it. Kickback is a specialized alternative, not a purchased permission to recover."
          },
          {
            "id": "W18.RECOVERY.02",
            "text": "The working sequence is support assessment, latch seating, loading, release, recontact and stabilization. Visible motion and available energy must agree."
          },
          {
            "id": "W18.RECOVERY.03",
            "text": "Body support must permit the hinge to work. A rigid frame crossing its required flex region must be adapted through real geometry, not ignored during the recovery animation."
          },
          {
            "id": "W18.RECOVERY.04",
            "text": "A greater snap can move the body farther without producing a better landing. Select useful recoil and control within the intended host/contact conditions."
          },
          {
            "id": "W18.RECOVERY.05",
            "text": "A powerless, suspended or pinned body cannot invent a supporting surface. On an aerial catch deck, Kickback can be useful after actual contact; it does not re-ignite flight in midair."
          },
          {
            "id": "W18.RECOVERY.06",
            "text": "Routine readiness and rest can be handled by the chosen preparation/behavior profile. No global per-use damage lottery or guaranteed no-damage rule is established."
          },
          {
            "id": "W18.RECOVERY.07",
            "text": "A recovery that leaves the legal route follows the same re-entry rules as any other displacement. The organ never awards checkpoints or finish credit."
          }
        ],
        "example": "A Broadback resting inverted on a low open platform can use a suitably installed hinge if its roots and support allow rotation. The same construction under a tight crossbeam can lack clearance. An exposed native leg or a different shell/brace arrangement may be the useful response instead.",
        "limits": "The study-derived latch sequence supports the mechanism description, not guaranteed recovery rates or an implemented articulated solver.",
        "prior": [
          "W14.ACTION.RIGHT",
          "W16.MATERIAL.ELASTIC",
          "W17.AMEND.03"
        ],
        "sources": [
          "W18.S08",
          "W18.S09"
        ]
      },
      {
        "id": "W18.SYSTEM.DISCHARGE",
        "title": "Boiler: a reachable pulse, not a remote attack score",
        "problem": "A spray can be reduced to damage plus cooldown, losing its distinct material, mounting and positional decisions.",
        "definition": "A Boiler has contained material, pulse generation, outlet articulation and an activation/recovery sequence. It affects material actually reached by the discharge under the adopted contact/damage model. On a Flyer the host’s posture, air motion and its own sweep envelope also affect use.",
        "rules": [
          {
            "id": "W18.DISCHARGE.01",
            "text": "Store fill, chamber readiness, outlet response and material replenishment are different states. Time after a pulse does not automatically create replacement contents."
          },
          {
            "id": "W18.DISCHARGE.02",
            "text": "One burst can contain internal pulses; these are not separate free player attacks. A second outlet shares actual supply unless a second reservoir is physically included."
          },
          {
            "id": "W18.DISCHARGE.03",
            "text": "The permitted discharge direction follows the mounted outlet’s range and host control. It does not inherit omnidirectional aiming regardless of surrounding limbs or wings."
          },
          {
            "id": "W18.DISCHARGE.04",
            "text": "A pulse has a finite route and duration. A rival outside it receives no effect because the attack animation completed; an intersecting non-target can be exposed under the same stated rules."
          },
          {
            "id": "W18.DISCHARGE.05",
            "text": "Mounts must be assessed against the host’s moving wing and limb envelope, not only a static inspection pose. A useful rear-facing ground pattern can be poorly placed on a Flyer."
          },
          {
            "id": "W18.DISCHARGE.06",
            "text": "Closing the outlet stops further output; it does not delete an already emitted plume. A clean line or a restrained plan can be better than discharging into occupied air."
          },
          {
            "id": "W18.DISCHARGE.07",
            "text": "Ordinary Fireworks play can use a ready supplied gland and refill support. The donor’s parasitoid lifecycle and specialist receiving test remain optional supplier work."
          }
        ],
        "example": "An Airflare flyer gives up a crowded inside line rather than fire through its own hindwing sweep. On the next straight a real rearward encounter permits a short deterrent pulse. The maneuver still aims to improve finishing position, not earn attack-score points.",
        "limits": "No chemical recipe, fixed damage value, lethal effect or broadly approved hazardous-transport standard is specified. Fictional local contact consequences remain separate from global injury and loss policy.",
        "prior": [
          "W14.PART.BOILER",
          "W16.MATERIAL.GLAND",
          "W14.SET.FIRE"
        ],
        "sources": [
          "W18.S11",
          "W18.S12"
        ]
      }
    ],
    "assembly_sheets": [
      {
        "id": "W18.PREP.LONGWING",
        "name": "Locust Longwing / complete array",
        "role": "Powered surfaces and articulated roots",
        "source_refs": [
          "W18.DONOR.LONGWING",
          "W14.PART.LONGWING"
        ],
        "anatomy": "Two narrow forewings and two folding fan hindwings, their preserved useful roots and the specified attachment interfaces. The structural pairing is left/right, with fore/hind identity retained. A surface-only pack states that it excludes the living root and is not a ready flight array.",
        "measurement": "Supported sweep, loaded form, usable root travel, equivalent-duty output and folding condition. Separate source asymmetry from preparation bias. Higher unloaded span or a straighter displayed wing is not a complete quality claim.",
        "fitting": "Locate roots around the center of supported mass, reserve their whole sweep and choose an appropriate Return-link yoke. Do not force a fan shut merely to fit a narrow frame while pretending powered support remains unchanged.",
        "working_sequence": "Open through its allowed geometry, maintain the selected working stroke, change attitude with available control, then fold only under a mode where the loss or change of support is accounted for.",
        "handling": "Use a source-appropriate fold cradle with independent root support and protected margins. A damaged side can be rematched to real replacement stock if the resulting complete array is assessed again.",
        "buyer": "Longline makers and owners who need repeatable forward flight with a manageable carrying form.",
        "boundary": "Complete means the listed surfaces and roots; drive, reserve and yoke are separate unless the tin explicitly includes them. Not a powered version of a passive Browfoil by name alone."
      },
      {
        "id": "W18.PREP.QUADWING",
        "name": "Dragonfly Quadwing / matched flight array",
        "role": "Four working surfaces and roots",
        "source_refs": [
          "W16.DONOR.GLASSWING",
          "W14.PART.QUADWING"
        ],
        "anatomy": "Four source-identified narrow wings and roots arranged as the actual front/rear, left/right array. Every wing need not originate from one donor, but a mixed array needs a whole-array response and fit assessment.",
        "measurement": "Root travel, paired balance, relevant deformation and performance under the intended coordination and burden. A source-matched damaged pair is not necessarily better than a correctly rematched pair.",
        "fitting": "Provide continuous working clearance and the chosen Crossphase relationship. A recipe does not assume every shape can fold above the abdomen. Gyropods are optional only where native information and control already meet the advertised ordinary construction.",
        "working_sequence": "Initiate the supported stroke, establish flight, change relative drive/control where physically available, and prepare actual recontact. Hover is demonstrated at a stated loaded condition rather than awarded to every dragonfly label.",
        "handling": "Hold in a permitted open contour case, keeping membranes off restraints and living roots appropriately supplied. Freshly emerged whole stock has its own expansion needs and is not transported as a finished array.",
        "buyer": "Skyhook courtyard and controlled-gate builders, plus rematching specialists.",
        "boundary": "Wing counts and source identities do not each supply another independent full drive or reservoir."
      },
      {
        "id": "W18.PREP.FLIGHTDRIVE",
        "name": "Flight-configured drive bundle",
        "role": "Motor function with a different output connection",
        "source_refs": [
          "W14.PART.REDLINE",
          "W14.PART.TORQUE",
          "W16.DONOR.CICADA",
          "W16.DONOR.SCARAB"
        ],
        "anatomy": "A selected contractile preparation with output attachments appropriate to the wingstroke mechanism. It may use established Redline or Torque-source stock if the measured duty and actual preparation fit; a single name is not a universal flight restriction.",
        "measurement": "Useful force, cadence, efficiency, readiness and mass under the named duty. Continuous support and bursts can require different operating points; endurance is not established by one fast pulse.",
        "fitting": "Supply the bundle, brace its output and connect it to the yoke without pinching adjacent motion. A basic walking branch or retained native drive is stated independently.",
        "working_sequence": "Delivers work into the actual transmission. Throttle/effort adjustments describe the available range, not new energy. A loss of supply or outlet readiness limits work before a fictional flight meter intervenes.",
        "handling": "Buffered active-root handling and the agreed ordinary response check. Re-preparing a ground drive records labor, changed attachments and retest rather than cloning the original.",
        "buyer": "A Flyer buyer can purchase a matched drive/yoke service; a muscle breeder can supply useful ordinary output without cultivating wings.",
        "boundary": "A flight preparation is an output/duty adaptation, not automatically an upgrade over the same source in ground racing."
      },
      {
        "id": "W18.PREP.CROSSPHASE",
        "name": "Wingstroke Yoke / Crossphase pattern",
        "role": "Gait/transmission and relative timing",
        "source_refs": [
          "W18.PREP.QUADWING",
          "W14.MAP.GAIT"
        ],
        "anatomy": "A prepared lever-and-coupling assembly at the four working roots, built from the actual array junctions and separately supplied interface material where required. It is a construction pattern, not a newly discovered insect organ. Donor roots used here remain counted once.",
        "measurement": "Input/output travel, useful force range, fore/hind phase, left/right response, resistance and mass. The actual observations specify the assembled array; no scalar “synchronization score” chooses every duty.",
        "fitting": "Set a supported ordinary phase and lever range. A variable pattern identifies the movable control elements; the basic pattern has a fixed prepared setting. Native host control must be connected to any active adjustment.",
        "working_sequence": "Coordinates working strokes within supplied work. Changing the phase can favor another force or efficiency regime when the actual array supports it; it cannot duplicate energy or guarantee every maneuver.",
        "handling": "A root bridge protects geometry without keeping the array loaded. Replacement couplings are actual stock; rematching creates a new assembled measurement, not a different genealogy.",
        "buyer": "Skyhook fitters, research breeders testing root/fan interactions and customer-stock adaptation services.",
        "boundary": "Clockleaf Lockstep is not an automatic universal substitute: paired jump release and cyclic four-wing timing are different requirements."
      },
      {
        "id": "W18.PREP.RETURNLINK",
        "name": "Wingstroke Yoke / Return-link pattern",
        "role": "Gait/transmission for the Longwing array",
        "source_refs": [
          "W18.PREP.LONGWING",
          "W14.MAP.GAIT"
